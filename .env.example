# Vercel Supabase Integration Variables
# POSTGRES_PRISMA_URL: Pooled connection string with ?pgbouncer=true (used for queries)
POSTGRES_PRISMA_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# POSTGRES_URL_NON_POOLING: Direct connection string (used for migrations and seed)
POSTGRES_URL_NON_POOLING="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Wompi (pasarela de pagos)
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_EVENTS_SECRET=test_events_secret_...
