# Supabase PostgreSQL - Transaction pooler (para queries en producción/serverless)
# Obtén esta URL en: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction
DATABASE_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL - Session pooler (para migraciones de Prisma directas)
# Obtén esta URL en: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session
DIRECT_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Wompi (pasarela de pagos)
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_EVENTS_SECRET=test_events_secret_...
