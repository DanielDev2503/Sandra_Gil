# Vercel Supabase Integration Variables
# DATABASE_URL / POSTGRES_PRISMA_URL: Supavisor Transaction Pooler (puerto 6543 con ?pgbouncer=true) para Serverless Functions
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
POSTGRES_PRISMA_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"

# DIRECT_URL / POSTGRES_URL_NON_POOLING: Conexión directa a PostgreSQL (puerto 5432) usada ÚNICAMENTE para prisma migrate y seed
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=no-verify"
POSTGRES_URL_NON_POOLING="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Wompi (pasarela de pagos)
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_EVENTS_SECRET=test_events_secret_...

# Dominio de producción / Base URL
NEXT_PUBLIC_APP_URL="https://sandragilvelas.com"
NEXT_PUBLIC_BASE_URL="https://sandragilvelas.com"

# Revalidación on-demand de caché (Next.js App Router)
REVALIDATION_SECRET="sandra_gil_cache_token_2026"
