// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoProducto {
  VELA
  JABON
}

model Producto {
  id            String       @id @default(uuid())
  nombre        String
  descripcion   String
  tipo          TipoProducto @default(VELA)
  aroma         String?
  aromaId       String?
  material      String?
  materialId    String?
  dimensiones   String?
  precio        Float?
  esBajoPedido  Boolean      @default(false)
  stock         Int
  url_imagen    String
  imagenes      String[]     @default([])
  activo        Boolean      @default(true)
  items         ItemPedido[]
  resenas       Resena[]
}

model Aroma {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())
}

model Material {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())
}


model Pedido {
  id                  String   @id @default(uuid())
  cliente_nombre      String
  cliente_email       String
  cliente_telefono    String
  ciudad              String   // 'Bogotá' o 'Alrededores'
  direccion_envio     String
  notas_entrega       String?
  total_productos     Float
  costo_envio         Float
  total_pagado        Float
  estado_pago          String   @default("pendiente") // 'pendiente', 'pagado', 'fallido'
  id_transaccion_wompi String?
  creado_en            DateTime @default(now())
  estado_envio         String   @default("PENDING") // PENDING, APPROVED, SHIPPED, DELIVERED, DECLINED
  numero_guia          String?
  notas_admin          String?
  items                ItemPedido[]
}

model ItemPedido {
  id              String   @id @default(uuid())
  pedido_id       String
  pedido          Pedido   @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto_id     String
  producto        Producto @relation(fields: [producto_id], references: [id])
  cantidad        Int
  precio_unitario Float
}

model Resena {
  id           String   @id @default(uuid())
  producto_id  String
  producto     Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  autor        String
  calificacion Int      // Valor de 1 a 5
  comentario   String
  creado_en    DateTime @default(now())
}

